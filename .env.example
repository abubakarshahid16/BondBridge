SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# No paid APIs are required for the current launch stack.
# Video uses browser WebRTC plus Supabase signaling.
# Proof review uses Supabase verification queues.
# Message coaching and safety moderation run locally in the app/worker.

